PORT=5000
MONGODB_URI=mongodb://localhost:27017/skillbridge_mvp
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Payment (Escrow - Paymob) - MVP: يعمل بوضع محاكاة (mock) لحد ما نربط الـ API الحقيقي
PAYMOB_API_KEY=your_paymob_api_key_here
PAYMENT_MODE=mock

# File Upload
UPLOAD_DIR=uploads

# Gemini AI (تحليل CV الحقيقي - شغل عضو AI التاني)
# لو الـ key ده فاضي أو مش موجود، هيفضل يشتغل بس endpoint الـ Rule-Based القديم (/api/ai/cv/analyze)
GEMINI_API_KEY=your_gemini_api_key_here
# اسم الموديل - غيّريه لو "gemini-2.0-flash" مش الاسم الصحيح عندكم في Google AI Studio
GEMINI_CV_MODEL=gemini-2.0-flash
